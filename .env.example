# Datadog (값은 Cursor mcp.json에서 옮겨 씀, 커밋 금지)
DD_API_KEY=
DD_APP_KEY=
DD_SITE=
DD_RUM_APP_ID=
DD_RUM_CLIENT_TOKEN=
# Agent hostname (로컬: bitsburg-local, EC2: bitsburg-demo)
DD_HOSTNAME=

# admin API 토큰 (openssl rand -hex 24)
ADMIN_TOKEN=

# 앱 버전
APP_VERSION_STABLE=3.4.2
APP_VERSION_NEW=3.5.0

# 선택
WEB_PORT=80
ORDER_DB_POOL_SIZE=10
TRAFFIC_MODE=baseline
TRAFFIC_CONCURRENCY=10
TRAFFIC_DURATION=0
TRAFFIC_TARGET=http://web
